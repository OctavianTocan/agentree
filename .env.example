# ---------------------------------------------------------------------------
# Completion provider
# ---------------------------------------------------------------------------

# Which structured-completion backend to use: claude or codex.
# Defaults to claude.
PDFINDEX_COMPLETION_CLIENT=claude

# ---------------------------------------------------------------------------
# Claude Agent SDK
# ---------------------------------------------------------------------------

# OAuth token from `claude setup-token`.
PDFINDEX_CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...

# Claude model alias: haiku, sonnet, opus, or fable. Defaults to haiku.
PDFINDEX_CLAUDE_MODEL=haiku

# ---------------------------------------------------------------------------
# Codex (OpenAI Codex Agent SDK)
# ---------------------------------------------------------------------------

# Codex model id. Defaults to gpt-5.5.
# Options include: gpt-5.6, gpt-5.5, gpt-5.4-mini, gpt-5.4, gpt-5.3-codex-spark
PDFINDEX_CODEX_MODEL=gpt-5.5

# Reasoning effort for Codex runs: none, minimal, low, medium, high, xhigh.
# Defaults to medium.
PDFINDEX_CODEX_REASONING_EFFORT=medium

# Codex personality: none, friendly, or pragmatic. Defaults to pragmatic.
PDFINDEX_PERSONALITY=pragmatic

# ---------------------------------------------------------------------------
# Indexing pipeline
# ---------------------------------------------------------------------------

# Token budget per chunk sent to the model. Defaults to 20000.
PDFINDEX_MAX_TOKENS_PER_CHUNK=20000

# How many leading pages to scan for an embedded table of contents. Defaults to 20.
PDFINDEX_TOP_CHECK_PAGE_NUM=20

# Set to 1 to run live Claude/Codex integration tests (requires valid credentials).
# PDFINDEX_RUN_LIVE_TESTS=1
