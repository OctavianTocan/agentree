# ---------------------------------------------------------------------------
# Completion provider
# ---------------------------------------------------------------------------

# Which structured-completion backend to use: claude or codex.
# Defaults to claude.
AGENTREE_COMPLETION_CLIENT=claude

# Set to 0/false to skip AI completions (empty structured responses, no provider calls).
# Defaults to true.
AGENTREE_COMPLETIONS_ENABLED=true

# ---------------------------------------------------------------------------
# Claude Agent SDK
# ---------------------------------------------------------------------------

# OAuth token from `claude setup-token`. Leave empty until you paste a real token locally.
# Never commit a filled .env.
AGENTREE_CLAUDE_CODE_OAUTH_TOKEN=

# Claude model: a short alias (haiku, sonnet, opus, fable) or a full model id
# (e.g. claude-opus-4-8). Defaults to haiku.
AGENTREE_CLAUDE_MODEL=haiku

# Reasoning effort for Claude runs: low, medium, high, xhigh, max.
# Defaults to low.
AGENTREE_CLAUDE_REASONING_EFFORT=low

# Model to retry with on Claude overload/capacity errors. Unset to disable.
# AGENTREE_CLAUDE_FALLBACK_MODEL=sonnet

# Hard USD ceiling per Claude query. Unset for no cap.
# AGENTREE_CLAUDE_MAX_BUDGET_USD=0.50

# Cap on thinking tokens per Claude query (switches thinking to a fixed budget).
# Unset for adaptive thinking.
# AGENTREE_CLAUDE_MAX_THINKING_TOKENS=4096

# ---------------------------------------------------------------------------
# Codex (OpenAI Codex Agent SDK)
# ---------------------------------------------------------------------------

# Codex model id. Defaults to gpt-5.5 (newest model that still supports the
# personality option; gpt-5.6-sol is the backend default but dropped personality).
# Options: gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna, gpt-5.5, gpt-5.4,
# gpt-5.4-mini, gpt-5.3-codex-spark
AGENTREE_CODEX_MODEL=gpt-5.5

# Don't persist Codex threads (throwaway one-shot turns). Defaults to true.
AGENTREE_CODEX_EPHEMERAL=true

# Codex service tier: e.g. priority, flex. Unset uses the model's default tier.
# AGENTREE_CODEX_SERVICE_TIER=priority

# Reasoning effort for Codex runs: none, minimal, low, medium, high, xhigh,
# max, ultra (max/ultra are gpt-5.6-only). Defaults to none.
AGENTREE_CODEX_REASONING_EFFORT=none

# Codex personality: none, friendly, or pragmatic. Defaults to pragmatic.
AGENTREE_PERSONALITY=pragmatic

# ---------------------------------------------------------------------------
# Indexing pipeline
# ---------------------------------------------------------------------------

# Token budget per chunk sent to the model. Defaults to 20000.
AGENTREE_MAX_TOKENS_PER_CHUNK=20000

# How many leading pages to scan for an embedded table of contents. Defaults to 20.
AGENTREE_TOP_CHECK_PAGE_NUM=20

# Set to 1 to run live Claude/Codex integration tests (requires valid credentials).
# AGENTREE_RUN_LIVE_TESTS=1
