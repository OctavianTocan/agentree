# The Claude Agent SDK drives the bundled Claude Code CLI under the hood.
# Authenticate with the your OAUTH_TOKEN

# Preferred: OAuth token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...

# Model for both indexer and retrieval: full id or a Claude Code alias.
LLM_MODEL=claude-sonnet-5

# Pages per indexing window.
PAGES_PER_INDEXING_WINDOW=12
